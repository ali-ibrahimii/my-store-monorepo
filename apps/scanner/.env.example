# متغیرهای اپ اسکنر — این‌ها در زمان *بیلد* خوانده می‌شوند.
# در ورسل: Project → Settings → Environment Variables (برای Production هم بگذارید)
# و بعد Redeploy کنید؛ بدون Redeploy اثر نمی‌کنند.

# آدرس وب‌اپ اصلی (همان جایی که فاکتورها و چاپ هستند) — بدون اسلش آخر
VITE_API_URL="https://my-store-monorepo.vercel.app"

# اگر دامنه‌ی اختصاصی دارید، آدرس عمومی وب‌اپ را اینجا بگذارید
# (برای دکمه‌ی «نسخه چاپ فاکتور» و «پنل وب» استفاده می‌شود)
# VITE_WEB_URL="https://app.example.com"
