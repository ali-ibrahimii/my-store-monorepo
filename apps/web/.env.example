# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (your machine: docker-compose Postgres 16) ---
# pnpm docker:up   →   postgres:16 on :5432, redis:7 on :6379
DATABASE_URL="postgresql://postgres:password@localhost:5432/mystore?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Auth (next-auth v5) ---
NEXTAUTH_URL="http://localhost:3000"
# Generate one: openssl rand -base64 32
AUTH_SECRET="change-me"
NEXTAUTH_SECRET="change-me"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Prisma connection pool ---
# Default is 10 (right for real Postgres). The sandbox dev DB (PGlite,
# tooling/dev-db) is single-user and needs PRISMA_POOL_MAX=1.
# PRISMA_POOL_MAX=10
