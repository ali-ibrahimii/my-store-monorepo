# یک کپی از این فایل به نام .env.local بسازید.
# هرگز .env.local را commit نکنید.
#
# ۱) در سوپابیس یک پروژه بسازید
# ۲) SQL Editor → supabase/migrations/0001_init.sql را کامل اجرا کنید
# ۳) Project Settings → API Keys: آدرس و کلیدها را اینجا بگذارید.
#    کلید publishable برای مرورگر و secret فقط برای سرور است.
# ۴) Authentication → Providers → Email را روشن کنید
#    (Confirm email را خاموش کنید تا ورود بلافاصله کار کند)
# ۵) pnpm db:seed

NEXT_PUBLIC_SUPABASE_URL="https://kmktigkdevdbnuqtohnn.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_VI5I859BSqFDqCm_H4tugA_TWruj2Sj"
SUPABASE_SECRET_KEY="your-secret-key"

# نام‌های قدیمی Supabase هم پشتیبانی می‌شوند:
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# آدرس اپ اسکنر گوشی (اختیاری) — برای دکمه‌ی «باز کردن اپ اسکنر» در صفحه‌ی اسکن
# NEXT_PUBLIC_SCANNER_URL="https://scan.example.com"

# دامنه‌های مجاز اپ اسکنر، جداشده با کاما. خالی یا * = همه
# CORS_ORIGINS="https://scan.example.com"
