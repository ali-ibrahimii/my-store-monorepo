# یک کپی از این فایل به نام .env.local بسازید.
# هرگز .env.local را commit نکنید.
#
# ۱) در سوپابیس یک پروژه بسازید
# ۲) SQL Editor → supabase/migrations/0001_init.sql را کامل اجرا کنید
# ۳) Project Settings → API : آدرس و کلیدها را اینجا بگذارید
# ۴) Authentication → Providers → Email را روشن کنید
#    (Confirm email را خاموش کنید تا ورود بلافاصله کار کند)
# ۵) pnpm db:seed

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# دامنه‌های مجاز اپ اسکنر، جداشده با کاما. خالی یا * = همه
# CORS_ORIGINS="https://scan.example.com"
