# یک کپی از این فایل به نام .env.local بسازید و مقدارها را پر کنید.
# هرگز .env.local را commit نکنید.
#
# ✅ نیازی به کار دستی نیست: `pnpm dev` اگر .env.local نباشد خودش این
#    فایل را می‌سازد و برای AUTH_SECRET یک مقدار تصادفی می‌گذارد.

# --- MongoDB -------------------------------------------------
# ۱) با Docker (پیشنهاد اصلی):   pnpm docker:up
# ۲) بدون Docker (محیط sandbox):  pnpm db:sandbox
# ۳) MongoDB Atlas (ابری):        رشته‌ی اتصال را از Atlas کپی کنید
#
# نکته: directConnection=true یعنی «مستقیم به همین آدرس وصل شو».
# برای replica set تک‌گرهی (docker-compose ما) لازم است.
MONGODB_URI="mongodb://127.0.0.1:27017/mystore?directConnection=true"

# نام دیتابیس — اگر در URI مشخص کرده باشید نیازی نیست
# MONGODB_DB="mystore"

# مثال MongoDB Atlas:
# MONGODB_URI="mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/mystore"

# --- تراکنش‌ها ------------------------------------------------
# auto  → خودش تشخیص می‌دهد سرور از تراکنش پشتیبانی می‌کند یا نه (پیش‌فرض)
# on    → همیشه از تراکنش استفاده کن (نیاز به replica set)
# off   → هرگز (نوشتن‌ها به‌ترتیب انجام می‌شوند)
# MONGODB_TRANSACTIONS="auto"

# --- Redis (اختیاری — برای همگام‌سازی لحظه‌ای بین چند سرور) ----
REDIS_URL="redis://localhost:6379"

# --- Auth (Auth.js / next-auth v5) ---------------------------
# ⚠️ AUTH_SECRET مهم است: اگر تنظیم نشود، Proxy (که نشست را می‌خواند)
#    نمی‌تواند JWT را باز کند و بعد از ورود، دوباره به /login برمی‌گردید.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# یک رمز بسازید:  openssl rand -base64 32
AUTH_SECRET="change-me"
NEXTAUTH_SECRET="change-me"

# --- seed خودکار داده‌ی نمونه (فقط محیط توسعه) ----------------
# `pnpm dev` به‌طور خودکار داده‌ی نمونه را می‌ریزد (اگر دیتابیس خالی باشد)
# اگر 0 بگذارید، داده‌ی نمونه ساخته نمی‌شود و باید pnpm db:seed بزنید
# AUTO_SEED="1"

# --- پورت/آدرس سرور توسعه ------------------------------------
# PORT="3000"     # اگر خالی بماند، Next پورت آزاد بعدی را می‌گیرد
# HOST="0.0.0.0"  # برای دسترسی از موبایل/پیش‌نمایش
# MONGO_HOST="0.0.0.0"  # فقط اگر می‌خواهید دیتابیس توسعه از بیرون هم باز باشد
