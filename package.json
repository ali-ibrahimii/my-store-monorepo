{
  "name": "my-store-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:seed": "pnpm --filter web db:seed",
    "db:reset": "pnpm --filter web db:seed -- --fresh",
    "db:ensure": "pnpm --filter web db:ensure",
    "db:sandbox": "pnpm --filter @my-store/dev-db start",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f mongo"
  },
  "devDependencies": {
    "prettier": "^3.2.0",
    "turbo": "^2.10.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
