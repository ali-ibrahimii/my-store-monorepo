{
  "name": "my-store-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:push": "pnpm --filter web prisma db push",
    "db:migrate": "pnpm --filter web prisma migrate dev",
    "db:studio": "pnpm --filter web prisma studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "db:seed": "pnpm --filter web exec node prisma/seed.mjs",
    "db:sandbox": "pnpm --filter @my-store/dev-db start"
  },
  "devDependencies": {
    "prettier": "^3.2.0",
    "turbo": "^2.10.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  }
}