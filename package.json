{
  "name": "my-store-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev --filter=web --filter=@my-store/scanner",
    "dev:web": "pnpm --filter web dev",
    "dev:scanner": "pnpm --filter @my-store/scanner dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:seed": "pnpm --filter web db:seed"
  },
  "devDependencies": {
    "prettier": "^3.2.0",
    "turbo": "^2.10.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.7"
    }
  }
}
